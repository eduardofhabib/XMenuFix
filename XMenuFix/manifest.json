{
  "manifest_version": 3,
  "name": "X Menu Fix",
  "description": "Move 'Copy Link' to the top of the share menu on X (Twitter)",
  "version": "1.0",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://twitter.com/*", "*://x.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
